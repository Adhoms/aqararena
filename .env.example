# Copy this file to .env and fill in real values. Never commit .env.
# Without DATABASE_URL the site runs on the built-in demo data.

# ── Option A: local database for development (no account needed) ──────────
# 1. npm run db:local      (starts it in the background)
# 2. npm run db:migrate    (creates the tables)
# 3. npm run db:seed       (loads the demo projects)
DATABASE_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable"
SHADOW_DATABASE_URL="postgres://postgres:postgres@localhost:51215/template1?sslmode=disable"
# The local database takes one connection at a time.
DATABASE_POOL_MAX=1

# ── Option B: hosted PostgreSQL (Neon) for the live site ──────────────────
# See docs/DEPLOY.md. Copy both strings from Neon's "Connect" dialog and remove the
# SHADOW_DATABASE_URL and DATABASE_POOL_MAX lines above.
#   DATABASE_URL = the pooled string (host contains "-pooler"), used by the site
#   DIRECT_URL   = the direct string (no "-pooler"), used for migrations
# Apply the tables with `npx prisma migrate deploy`.
# Load demo data only on purpose: ALLOW_DEMO_SEED=1 npm run db:seed
# DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

# ── Admin dashboard (/admin) ───────────────────────────────────────────────
# The single admin password. Use a long random value in production.
ADMIN_PASSWORD="change-me"
# Optional: separate key for signing the session cookie (defaults to ADMIN_PASSWORD).
# ADMIN_SESSION_SECRET=""
# Optional: key for signing developer portal sessions (defaults to the admin settings above).
# PORTAL_SESSION_SECRET=""
# Key for signing AqarArena Sales sessions (/sales). Set a long random value in production;
# without it the portal/admin settings above are used.
# SALES_SESSION_SECRET=""

# ── File uploads (Vercel Blob) ─────────────────────────────────────────────
# Set automatically on Vercel when a Blob store is connected to the project.
# Locally, copy it from Vercel (Storage → the store → .env.local) to test uploads;
# without it the admin can still paste links.
# BLOB_READ_WRITE_TOKEN=""
