// AqarArena database schema. See docs/DATA-MODEL.md for the reasoning.
// Hierarchy: Developer → Project → Typology (unit model) → Unit.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// PostGIS (for map search, roadmap phase 3) is added with its own migration later.
// Until then projects keep plain latitude/longitude.
datasource db {
  provider = "postgresql"
}

// ─── Enums ──────────────────────────────────────────────────────────────

enum DeveloperPlan {
  BASIC
  PRO
  ENTERPRISE
}

enum ProjectStatus {
  LAUNCH
  UNDER_CONSTRUCTION
  READY
  DELIVERED
}

enum PropertyCategory {
  RESIDENTIAL
  COMMERCIAL
  ADMINISTRATIVE
  MEDICAL
  COASTAL
}

enum PropertySubType {
  // Residential
  APARTMENT
  STUDIO
  DUPLEX
  PENTHOUSE
  TOWNHOUSE
  TWIN_HOUSE
  VILLA
  MANSION
  // Commercial, administrative, medical
  OFFICE
  CLINIC
  RETAIL
  FOOD_AND_BEVERAGE
  PHARMACY
  BANK
  // Coastal & hospitality
  CHALET
  CABIN
  SERVICED_APARTMENT
}

enum FinishingType {
  CORE_AND_SHELL
  SEMI_FINISHED
  FULLY_FINISHED
  FULLY_FINISHED_WITH_AC
  FURNISHED
}

enum UnitAvailability {
  AVAILABLE
  RESERVED
  SOLD
}

enum InstallmentFrequency {
  MONTHLY
  QUARTERLY
  SEMI_ANNUAL
  ANNUAL
}

enum MediaKind {
  IMAGE
  VIDEO
  FLOOR_PLAN_2D
  LAYOUT_SKETCH
  MODEL_3D
  VIRTUAL_TOUR
  MASTER_PLAN
  BROCHURE
}

/// Photo tabs on the project page.
enum MediaGroup {
  EXTERIOR
  INTERIOR
  CONSTRUCTION
}

/// What a clickable master-plan zone contains.
/// A developer login. Requests from the "for developers" page start as PENDING.
enum AccountStatus {
  PENDING
  ACTIVE
  DISABLED
}

enum SubmissionKind {
  DEVELOPER_PROFILE
  PROJECT
}

/// DRAFT: the developer is still editing. PENDING: waiting for the admin.
enum SubmissionStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
}

enum ZoneKind {
  RESIDENTIAL
  VILLAS
  GREEN
  AMENITY
  COMMERCIAL
  ADMINISTRATIVE
}

// ─── Locations ──────────────────────────────────────────────────────────

/// Areas nest: e.g. Cairo › New Cairo › Fifth Settlement.
model Area {
  id        String    @id @default(cuid())
  slug      String    @unique
  nameAr    String
  nameEn    String
  parentId  String?
  parent    Area?     @relation("AreaTree", fields: [parentId], references: [id])
  children  Area[]    @relation("AreaTree")
  projects  Project[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([parentId])
}

// ─── Developers & projects ──────────────────────────────────────────────

model Developer {
  id            String             @id @default(cuid())
  slug          String             @unique
  nameAr        String
  nameEn        String
  logoUrl       String?
  coverUrl      String?
  foundedYear   Int?
  aboutAr       String?
  aboutEn       String?
  website       String?
  hotline       String?
  salesPhone    String?
  whatsapp      String?
  email         String?
  hqAddressAr   String?
  hqAddressEn   String?
  verified      Boolean            @default(false)
  plan          DeveloperPlan      @default(BASIC)
  /// How many hours an AqarArena Sales hold lasts (1–168), set in the portal's «فريق المبيعات». A project can override it.
  holdHours     Int                @default(48)
  projects      Project[]
  accounts      DeveloperAccount[]
  submissions   Submission[]
  salesAccounts SalesAccount[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
}

model Project {
  id            String             @id @default(cuid())
  slug          String             @unique
  developerId   String
  developer     Developer          @relation(fields: [developerId], references: [id], onDelete: Cascade)
  areaId        String
  area          Area               @relation(fields: [areaId], references: [id])
  nameAr        String
  nameEn        String
  descriptionAr String?
  descriptionEn String?
  /// Neighbourhood inside the area, e.g. "Fifth Settlement" in New Cairo.
  districtAr    String?
  districtEn    String?
  /// Every kind of space the project offers (a compound can be residential + commercial + medical).
  categories    PropertyCategory[]

  latitude  Decimal? @db.Decimal(9, 6)
  longitude Decimal? @db.Decimal(9, 6)

  landAreaM2      Decimal?      @db.Decimal(12, 2)
  /// Share of the land covered by buildings, in percent. Green/open space is the rest.
  footprintPct    Decimal?      @db.Decimal(5, 2)
  unitsCount      Int?
  status          ProjectStatus @default(LAUNCH)
  launchDate      DateTime?     @db.Date
  deliveryDate    DateTime      @db.Date
  progressPct     Int?
  /// When the developer last confirmed the prices and payment plans.
  pricesUpdatedAt DateTime?     @db.Date
  /// Refundable amount to reserve a unit at launch (EOI), in EGP.
  bookingFee      Decimal?      @db.Decimal(12, 2)
  /// Amenity keys such as "clubhouse", "underground_parking", "mall", "school".
  amenities       String[]
  /// Base URL of the tiled master-plan image set.
  masterPlanUrl   String?
  isFeatured      Boolean       @default(false)
  published       Boolean       @default(false)
  /// Overrides the developer's hold length for this project only (1–168), e.g. a few hours on launch day. Empty = the developer's.
  holdHours       Int?

  typologies          Typology[]
  zones               MasterPlanZone[]
  distances           ProjectDistance[]
  media               Media[]
  paymentPlans        PaymentPlan[]
  offers              Offer[]
  constructionUpdates ConstructionUpdate[]
  priceHistory        PriceHistory[]
  submissions         Submission[]
  priceAlerts         PriceAlert[]
  stats               ProjectStat[]
  /// Prices and plans as of the last alert sent to subscribers (or when the first one signed up).
  alertSnapshot       Json?
  /// When the admin was last emailed about the developer changing this project's units (at most hourly).
  unitsNotifiedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([developerId])
  @@index([areaId])
  @@index([status])
  @@index([published, isFeatured])
}

// ─── Unit models & units ────────────────────────────────────────────────

/// One unit model (e.g. "Type A – 150 m²"). Floor plans and 3D live here once,
/// not on every unit.
model Typology {
  id             String           @id @default(cuid())
  projectId      String
  project        Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  code           String
  nameAr         String?
  nameEn         String?
  category       PropertyCategory
  subType        PropertySubType
  buaM2          Decimal          @db.Decimal(8, 2)
  netM2          Decimal?         @db.Decimal(8, 2)
  gardenM2       Decimal?         @db.Decimal(8, 2)
  roofM2         Decimal?         @db.Decimal(8, 2)
  terraceM2      Decimal?         @db.Decimal(8, 2)
  bedrooms       Int?
  bathrooms      Int?
  finishing      FinishingType
  priceFrom      Decimal?         @db.Decimal(14, 2)
  pricePerM2From Decimal?         @db.Decimal(12, 2)

  units        Unit[]
  media        Media[]
  paymentPlans PaymentPlan[]
  priceHistory PriceHistory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, code])
  @@index([category, subType])
  @@index([priceFrom])
}

model Unit {
  id           String           @id @default(cuid())
  typologyId   String
  typology     Typology         @relation(fields: [typologyId], references: [id], onDelete: Cascade)
  building     String?
  floor        Int?
  unitNumber   String?
  /// e.g. "north", "south-east"
  orientation  String?
  /// e.g. "landscape", "main_street", "lagoon", "sea"
  view         String?
  price        Decimal?         @db.Decimal(14, 2)
  availability UnitAvailability @default(AVAILABLE)
  holds        UnitHold[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([typologyId, availability])
}

// ─── Master plan & location ─────────────────────────────────────────────

/// A clickable area on the master plan. The shape is a rectangle in percent of
/// the plan image for now; it can become a polygon later.
model MasterPlanZone {
  id             String            @id @default(cuid())
  projectId      String
  project        Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  kind           ZoneKind
  shortAr        String
  shortEn        String
  nameAr         String
  nameEn         String
  phaseAr        String?
  phaseEn        String?
  descriptionAr  String?
  descriptionEn  String?
  areaFeddan     Decimal?          @db.Decimal(8, 2)
  buildingsCount Int?
  unitsCount     Int?
  /// Unit sub-types found in this zone.
  unitSubTypes   PropertySubType[]
  xPct           Decimal           @db.Decimal(5, 2)
  yPct           Decimal           @db.Decimal(5, 2)
  widthPct       Decimal           @db.Decimal(5, 2)
  heightPct      Decimal           @db.Decimal(5, 2)
  sortOrder      Int               @default(0)

  @@index([projectId])
}

/// Driving time from the project to a landmark ("Ring Road · 10 min").
model ProjectDistance {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  placeAr   String
  placeEn   String
  minutes   Int
  sortOrder Int     @default(0)

  @@index([projectId])
}

// ─── Media ──────────────────────────────────────────────────────────────

/// Files live in object storage (Cloudflare R2); this table stores their URLs.
model Media {
  id         String      @id @default(cuid())
  kind       MediaKind
  /// Set on project photos so they can be shown under the right tab.
  group      MediaGroup?
  url        String
  width      Int?
  height     Int?
  captionAr  String?
  captionEn  String?
  sortOrder  Int         @default(0)
  projectId  String?
  project    Project?    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  typologyId String?
  typology   Typology?   @relation(fields: [typologyId], references: [id], onDelete: Cascade)
  createdAt  DateTime    @default(now())

  @@index([projectId, kind])
  @@index([typologyId, kind])
}

// ─── Money ──────────────────────────────────────────────────────────────

model PaymentPlan {
  id                 String               @id @default(cuid())
  projectId          String
  project            Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// Set when a plan applies to one unit model only.
  typologyId         String?
  typology           Typology?            @relation(fields: [typologyId], references: [id], onDelete: Cascade)
  nameAr             String?
  nameEn             String?
  downPaymentPct     Decimal              @db.Decimal(5, 2)
  deliveryPaymentPct Decimal              @default(0) @db.Decimal(5, 2)
  years              Int
  frequency          InstallmentFrequency @default(QUARTERLY)
  cashDiscountPct    Decimal?             @db.Decimal(5, 2)
  maintenancePct     Decimal?             @db.Decimal(5, 2)
  garageFee          Decimal?             @db.Decimal(12, 2)
  clubFee            Decimal?             @db.Decimal(12, 2)
  validUntil         DateTime?            @db.Date
  isActive           Boolean              @default(true)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  @@index([projectId, isActive])
  @@index([downPaymentPct, years])
}

model Offer {
  id          String    @id @default(cuid())
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  titleAr     String
  titleEn     String
  detailsAr   String?
  detailsEn   String?
  startsAt    DateTime?
  endsAt      DateTime?
  isSponsored Boolean   @default(false)
  createdAt   DateTime  @default(now())

  @@index([projectId])
  @@index([endsAt])
}

model PriceHistory {
  id         String    @id @default(cuid())
  projectId  String
  project    Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  typologyId String?
  typology   Typology? @relation(fields: [typologyId], references: [id], onDelete: Cascade)
  recordedAt DateTime  @db.Date
  pricePerM2 Decimal   @db.Decimal(12, 2)

  @@index([projectId, recordedAt])
}

// ─── Construction progress ───────────────────────────────────────────────────

model ConstructionUpdate {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  date        DateTime @db.Date
  progressPct Int?
  noteAr      String?
  noteEn      String?
  mediaUrls   String[]
  createdAt   DateTime @default(now())

  @@index([projectId, date])
}

// ─── Developer portal ───────────────────────────────────────────────────

/// A sign-in for a developer's staff. Nothing a developer sends goes live until the admin approves it.
model DeveloperAccount {
  id                 String        @id @default(cuid())
  username           String        @unique
  /// scrypt hash, see src/lib/portal/password.ts
  passwordHash       String
  status             AccountStatus @default(PENDING)
  /// Set when the account is approved (or created by the admin).
  developerId        String?
  developer          Developer?    @relation(fields: [developerId], references: [id], onDelete: Cascade)
  /// What the developer typed when asking for an account.
  companyNameAr      String?
  companyNameEn      String?
  contactName        String?
  phone              String?
  email              String?
  note               String?
  /// Set after the admin creates the account or resets its password.
  mustChangePassword Boolean       @default(false)
  /// Raised to sign the account out everywhere (password change, disable).
  sessionVersion     Int           @default(0)
  /// Set when the developer asks for a new password from the sign-in page; cleared when the admin issues one.
  resetRequestedAt   DateTime?
  lastLoginAt        DateTime?
  submissions        Submission[]
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([status])
  @@index([developerId])
}

/// A developer's proposed change: their company profile, or one project with its unit types,
/// payment plans, photos and distances. `data` holds the whole proposed version as typed in the
/// portal; approving it writes it to the live tables.
model Submission {
  id          String           @id @default(cuid())
  kind        SubmissionKind
  status      SubmissionStatus @default(DRAFT)
  accountId   String
  account     DeveloperAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  developerId String
  developer   Developer        @relation(fields: [developerId], references: [id], onDelete: Cascade)
  /// The live project being changed; empty for a new project (set once approved).
  projectId   String?
  project     Project?         @relation(fields: [projectId], references: [id], onDelete: SetNull)
  /// Project or company name, for lists.
  title       String
  data        Json
  /// The admin's reason when sending it back.
  reviewNote  String?
  submittedAt DateTime?
  reviewedAt  DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([status, submittedAt])
  @@index([developerId, status])
  @@index([projectId])
}

// ─── Sign-in protection ─────────────────────────────────────────────────

/// Wrong-password counts per IP address or username, to slow down guessing (src/lib/throttle.ts).
model AuthThrottle {
  key      String   @id
  failures Int      @default(0)
  resetAt  DateTime
}

// ─── Contact ────────────────────────────────────────────────────────────

enum MessageKind {
  SUGGESTION
  COMPLAINT
  HELP
  REQUEST
  OTHER
}

enum MessageStatus {
  NEW
  DONE
}

/// A message from the contact page (suggestion, complaint, help or request), read in /admin/messages.
model ContactMessage {
  id        String        @id @default(cuid())
  kind      MessageKind
  status    MessageStatus @default(NEW)
  name      String
  email     String?
  phone     String?
  message   String
  locale    String        @default("ar")
  createdAt DateTime      @default(now())

  @@index([status, createdAt])
}

// ─── Price alerts ───────────────────────────────────────────────────────

/// A visitor who asked to hear when a project's prices or payment plans change. No password:
/// the emailed token confirms the address and later unsubscribes it (unsubscribing deletes the row).
model PriceAlert {
  id          String    @id @default(cuid())
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String
  email       String
  phone       String?
  locale      String    @default("ar")
  token       String    @unique
  confirmedAt DateTime?
  lastSentAt  DateTime?
  createdAt   DateTime  @default(now())

  @@unique([projectId, email])
  @@index([projectId, confirmedAt])
}

// ─── Visitor statistics ─────────────────────────────────────────────────

/// What visitors did on a project. Counted once per browser session (see src/lib/stats.ts).
enum StatEvent {
  VIEW
  FAVORITE
  COMPARE
  OFFER
  CALL
  WHATSAPP
  WEBSITE
  EMAIL
  BROCHURE
  SHARE
}

/// One counter per project, day and kind of action. No visitor details are stored: no IP
/// address, cookie or identifier, only the daily total.
model ProjectStat {
  projectId String
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  day       DateTime  @db.Date
  event     StatEvent
  count     Int       @default(0)

  @@id([projectId, day, event])
  @@index([day])
}

// ─── AqarArena Sales ────────────────────────────────────────────────────

/// AGENT: sees their own clients and work. LEAD: also sees the whole team's.
enum SalesRole {
  AGENT
  LEAD
}

/// A member of a developer's sales team, created from the developer portal. Signs in at /sales.
/// The name and numbers here are the ones printed on that person's offers.
model SalesAccount {
  id                 String        @id @default(cuid())
  developerId        String
  developer          Developer     @relation(fields: [developerId], references: [id], onDelete: Cascade)
  username           String        @unique
  /// scrypt hash, see src/lib/portal/password.ts
  passwordHash       String
  role               SalesRole     @default(AGENT)
  /// ACTIVE or DISABLED (PENDING is not used for sales accounts).
  status             AccountStatus @default(ACTIVE)
  nameAr             String
  nameEn             String?
  phone              String
  whatsapp           String?
  email              String?
  mustChangePassword Boolean       @default(true)
  /// Raised to sign the account out everywhere (password change, disable).
  sessionVersion     Int           @default(0)
  lastLoginAt        DateTime?
  holds              UnitHold[]    @relation("HoldOwner")
  releasedHolds      UnitHold[]    @relation("HoldReleasedBy")
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([developerId, status])
}

/// ACTIVE: holding the unit until expiresAt. CONVERTED: the holder confirmed it (the unit is RESERVED). RELEASED: ended.
enum HoldStatus {
  ACTIVE
  CONVERTED
  RELEASED
}

/// Why a hold was released.
enum HoldReleaseReason {
  /// Its time ran out (marked the first time something touched it afterwards).
  EXPIRED
  /// The holder or a team lead cancelled it.
  CANCELLED
  /// The developer changed the unit's status in the portal (form, quick switch or Excel).
  PORTAL_STATUS_CHANGE
  /// The admin changed the unit's status (form or Excel import).
  ADMIN_STATUS_CHANGE
  /// The unit left its developer's Sales inventory: the project moved to another developer or was
  /// unpublished, or the unit type lost its starting price.
  OUT_OF_SALES
  /// The developer disabled the salesperson's account.
  ACCOUNT_DISABLED
}

/// A salesperson's temporary hold on a unit (spec section 6). At most one ACTIVE hold per unit:
/// the partial unique index "UnitHold_unitId_active_key" is written by hand in the migration, because
/// the schema can't describe it (Prisma 7.10 leaves it alone). Never drop it.
/// A hold counts while ACTIVE and expiresAt is in the future; see src/lib/sales/holds.ts.
model UnitHold {
  id             String             @id @default(cuid())
  unitId         String
  unit           Unit               @relation(fields: [unitId], references: [id], onDelete: Cascade)
  salesAccountId String
  /// Restrict: holds are history. src/app/admin/actions.ts deleteDeveloper clears them first.
  salesAccount   SalesAccount       @relation("HoldOwner", fields: [salesAccountId], references: [id], onDelete: Restrict)
  /// Who the unit is held for, until phase 4 adds clients.
  clientNote     String?            @db.VarChar(200)
  expiresAt      DateTime
  status         HoldStatus         @default(ACTIVE)
  /// The salesperson (holder or team lead) who cancelled it.
  releasedById   String?
  releasedBy     SalesAccount?      @relation("HoldReleasedBy", fields: [releasedById], references: [id], onDelete: SetNull)
  releaseReason  HoldReleaseReason?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([salesAccountId, status])
  @@index([unitId, status])
}
