{
  "name": "aqararena",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.17"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "vercel-build": "prisma generate && prisma migrate deploy && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "prisma db seed",
    "db:local": "prisma dev --detach --name aqararena",
    "db:reset": "prisma migrate reset"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@sparticuz/chromium": "153.0.0",
    "@vercel/blob": "^2.9.0",
    "exceljs": "^4.4.0",
    "maplibre-gl": "^6.19.0",
    "next": "16.4.6",
    "pg": "^8.23.1",
    "puppeteer-core": "25.11.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.8",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "prisma": "^7.10.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    },
    "@vercel/oidc": {
      "@vercel/cli-config": "^0.4.0"
    }
  }
}
